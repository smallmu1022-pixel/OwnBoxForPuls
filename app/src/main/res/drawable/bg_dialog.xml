<?xml version="1.0" encoding="utf-8"?>
<!-- OneBox 液态玻璃对话框：沿用原 bg_dialog 的 inset 结构（对话框边距），
     内层为半透明强填充 + 顶部高光 + 描边；颜色随深浅主题自动切换。 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/dialog_background_inset"
    android:insetTop="@dimen/dialog_background_inset"
    android:insetRight="@dimen/dialog_background_inset"
    android:insetBottom="@dimen/dialog_background_inset">

    <layer-list>
        <!-- 半透明渐变填充 -->
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/glass_dialog_corner_radius" />
                <gradient
                    android:angle="135"
                    android:startColor="?attr/glassFillStrongTop"
                    android:endColor="?attr/glassFillStrongBottom"
                    android:type="linear" />
            </shape>
        </item>

        <!-- 顶部高光 -->
        <item
            android:left="1dp"
            android:top="1dp"
            android:right="1dp"
            android:bottom="1dp">
            <shape android:shape="rectangle">
                <corners android:radius="27dp" />
                <gradient
                    android:angle="270"
                    android:startColor="?attr/glassHighlight"
                    android:endColor="#00FFFFFF"
                    android:type="linear" />
            </shape>
        </item>

        <!-- 折射边缘描边 -->
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/glass_dialog_corner_radius" />
                <stroke
                    android:width="1dp"
                    android:color="?attr/glassStroke" />
            </shape>
        </item>
    </layer-list>
</inset>
