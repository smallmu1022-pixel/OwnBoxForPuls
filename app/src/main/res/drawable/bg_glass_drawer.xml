<?xml version="1.0" encoding="utf-8"?>
<!-- OneBox 液态玻璃抽屉：强填充保证菜单文字可读，描边形成右侧分隔发丝线
     （左/上/下三边贴合屏幕边缘，仅右侧描边可见）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 半透明渐变填充 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="?attr/glassFillStrongTop"
                android:endColor="?attr/glassFillStrongBottom"
                android:type="linear" />
        </shape>
    </item>

    <!-- 顶部高光 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/glassHighlight"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- 折射边缘描边 -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="?attr/glassStroke" />
        </shape>
    </item>
</layer-list>
